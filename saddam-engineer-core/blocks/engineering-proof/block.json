{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "spcore/engineering-proof",
  "version": "1.0.0",
  "title": "Engineering Proof",
  "category": "widgets",
  "icon": "editor-code",
  "description": "Server-rendered proof of the WordPress engineering features implemented in this site.",
  "keywords": ["engineering", "wordpress", "proof", "architecture"],
  "textdomain": "spcore",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Implemented in this WordPress system"
    },
    "limit": {
      "type": "number",
      "default": 6
    },
    "showEvidence": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./editor.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
