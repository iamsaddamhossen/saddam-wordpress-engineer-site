<?xml version="1.0"?>
<ruleset name="Saddam Engineer Core">
  <description>WordPress coding standards for the portfolio plugin.</description>
  <file>./saddam-engineer-core.php</file>
  <file>./includes</file>
  <file>./blocks</file>
  <file>./tests</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg value="sp"/>
  <rule ref="WordPress"/>
  <rule ref="WordPress-Extra"/>
  <rule ref="WordPress-Docs"/>
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array" value="spcore"/>
    </properties>
  </rule>
  <rule ref="Generic.Files.LineLength">
    <properties>
      <property name="lineLimit" value="140"/>
      <property name="absoluteLineLimit" value="220"/>
    </properties>
  </rule>
</ruleset>
